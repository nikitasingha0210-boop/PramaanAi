# =========================================================================
# PramaanAI — environment configuration
# Copy this file to `.env` and adjust values. Never commit a real `.env`.
# =========================================================================

# --- App -----------------------------------------------------------------
APP_NAME=PramaanAI
ENV=development                     # development | production

# --- Database --------------------------------------------------------------
# Local zero-setup default (SQLite, no server required):
DATABASE_URL=sqlite:///./pramaanai.db
# Production / docker-compose (Postgres):
# DATABASE_URL=postgresql+psycopg2://pramaanai:pramaanai_dev_password@db:5432/pramaanai

# --- Auth ------------------------------------------------------------------
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_dev_only_insecure_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480      # 8-hour session, matches a shift length

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend (web/.env) -----------------------------------------------------
# Only needed if you run the frontend separately from the Vite dev proxy.
VITE_API_URL=http://localhost:8000
